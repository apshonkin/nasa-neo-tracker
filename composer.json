{
    "name": "apshonkin/nasa-neo-tracker",
    "description": "Трекер сближений астероидов",
    "keywords": [
        "yii2",
        "nasa",
        "neows",
        "apod",
        "asteroids",
        "postgresql",
        "redis"
    ],
    "homepage": "https://github.com/apshonkin/nasa-neo-tracker",
    "type": "project",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/apshonkin/nasa-neo-tracker/issues",
        "source": "https://github.com/apshonkin/nasa-neo-tracker"
    },
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.3",
        "ext-curl": "*",
        "ext-pdo_pgsql": "*",
        "yiisoft/yii2": "~2.0.54",
        "yiisoft/yii2-bootstrap5": "~2.0.2",
        "yiisoft/yii2-symfonymailer": "~2.0.3",
        "yiisoft/yii2-redis": "^2.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "yiisoft/yii2-coding-standards": "^3.0",
        "yiisoft/yii2-debug": "~2.1.0",
        "yiisoft/yii2-gii": "~2.2.0",
        "yii2-extensions/phpstan": "^0.4",
        "codeception/codeception": "^5.3",
        "codeception/module-asserts": "^3.0"
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        },
        "process-timeout": 1800,
        "fxp-asset": {
            "enabled": false
        }
    },
    "scripts": {
        "cs": "./vendor/bin/phpcs",
        "cs-fix": "./vendor/bin/phpcbf",
        "static": "./vendor/bin/phpstan --memory-limit=-1",
        "test": "./vendor/bin/codecept run"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    }
}

# Настройки для запуска в Docker. `make init` копирует файл в .env
# и сам генерирует COOKIE_VALIDATION_KEY. .env в git не попадает.

# --- Приложение ---------------------------------------------------------------
YII_DEBUG=1
YII_ENV=dev
APP_PORT=8899
COOKIE_VALIDATION_KEY=
# свой ключ бесплатно на https://api.nasa.gov, у DEMO_KEY лимит ~10 запросов в час
NASA_API_KEY=DEMO_KEY

# --- PostgreSQL ---------------------------------------------------------------
DB_NAME=neo_tracker
DB_USER=neo_tracker
DB_PASSWORD=neo_tracker
# порт на хосте, чтобы подключиться к базе в контейнере из IDE или psql
DB_HOST_PORT=55433

# --- Redis --------------------------------------------------------------------
REDIS_DATABASE=0
REDIS_HOST_PORT=56380
